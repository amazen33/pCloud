{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "context", "namespace", "purpose", "endpoint", "ca_file", "kv_mount", "auth_mount"],
  "properties": {
    "profile": {"enum": ["openbao-raft-lab", "supplied-vault-api"]},
    "context": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\s]+$"},
    "namespace": {"$ref": "#/$defs/name"},
    "purpose": {"enum": ["platform", "recovery"]},
    "endpoint": {"type": "string", "pattern": "^https://"},
    "ca_file": {"type": "string", "minLength": 1},
    "tls_secret": {"$ref": "#/$defs/name"},
    "storage_class": {"$ref": "#/$defs/name"},
    "storage_provisioner": {"type": "string", "minLength": 1},
    "workers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "operator_cidrs": {"$ref": "#/$defs/cidrs"},
    "api_cidrs": {"$ref": "#/$defs/cidrs"},
    "api_port": {"type": "integer", "enum": [443, 6443]},
    "kubernetes_host": {"type": "string", "pattern": "^https://"},
    "data_size": {"type": "string", "pattern": "^[1-9][0-9]*Gi$"},
    "audit_size": {"type": "string", "pattern": "^[1-9][0-9]*Gi$"},
    "resources": {"type": "object", "additionalProperties": false, "required": ["requests", "limits"], "properties": {"requests": {"$ref": "#/$defs/resources"}, "limits": {"$ref": "#/$defs/resources"}}},
    "kv_mount": {"$ref": "#/$defs/name"},
    "auth_mount": {"$ref": "#/$defs/name"}
  },
  "allOf": [{"if": {"properties": {"profile": {"const": "openbao-raft-lab"}}}, "then": {"required": ["tls_secret", "storage_class", "storage_provisioner", "workers", "operator_cidrs", "api_cidrs", "api_port", "kubernetes_host", "data_size", "audit_size", "resources"]}, "else": {"not": {"anyOf": [{"required": ["tls_secret"]}, {"required": ["workers"]}, {"required": ["storage_class"]}, {"required": ["resources"]}, {"required": ["kubernetes_host"]}, {"required": ["storage_provisioner"]}, {"required": ["operator_cidrs"]}, {"required": ["api_cidrs"]}, {"required": ["api_port"]}, {"required": ["data_size"]}, {"required": ["audit_size"]}]} }}],
  "$defs": {
    "name": {"type": "string", "maxLength": 63, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"},
    "cidrs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "resources": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory"], "properties": {"cpu": {"type": "string", "pattern": "^[1-9][0-9]*(m)?$"}, "memory": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"}}}
  }
}
