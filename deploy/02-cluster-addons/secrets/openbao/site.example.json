{
  "profile": "openbao-raft-lab",
  "context": "REPLACE-lab-context",
  "namespace": "pcloud-secrets-system",
  "purpose": "platform",
  "endpoint": "https://openbao.example.invalid:8200",
  "ca_file": "/operator/ca.pem",
  "tls_secret": "openbao-server-tls",
  "storage_class": "pcloud-local-retain",
  "storage_provisioner": "pcloud.io/local-path",
  "workers": ["replace-worker"],
  "operator_cidrs": ["192.0.2.10/32"],
  "api_cidrs": ["192.0.2.20/32"],
  "api_port": 6443,
  "kubernetes_host": "https://kubernetes.default.svc:443",
  "data_size": "8Gi",
  "audit_size": "2Gi",
  "resources": {"requests": {"cpu": "250m", "memory": "256Mi"}, "limits": {"cpu": "1", "memory": "512Mi"}},
  "kv_mount": "pcloud-platform",
  "auth_mount": "pcloud-kubernetes"
}
