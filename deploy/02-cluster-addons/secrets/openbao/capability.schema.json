{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["api", "profile", "endpoint", "kv_v2_mount", "kubernetes_auth_mount", "tls_verification", "credential_delivery", "ha", "acceptance"],
  "properties": {
    "api": {"const": "pcloud.secrets/v1"}, "profile": {"enum": ["openbao-raft-lab", "supplied-vault-api"]},
    "endpoint": {"type": "string", "pattern": "^https://"},
    "kv_v2_mount": {"type": "string"}, "kubernetes_auth_mount": {"type": "string"},
    "tls_verification": {"const": "trusted-ca-and-hostname"},
    "credential_delivery": {"const": "projected-service-account-jwt; scoped-short-lived-token"},
    "ha": {"const": false}, "acceptance": {"const": "requires-live-conformance-and-recovery-evidence"}
  }
}
