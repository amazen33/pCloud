{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "context", "resources"],
  "properties": {
    "profile": {"enum": ["node-local-lab", "supplied-storage"]},
    "context": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$"},
    "storage_root": {"type": "string", "pattern": "^/var/lib/pcloud/storage/[a-zA-Z0-9_/-]+$"},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "ssh", "filesystem_uuid"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$"},
        "ssh": {"type": "string", "pattern": "^[a-z_][a-z0-9_-]*@[a-zA-Z0-9][a-zA-Z0-9.-]*$"},
        "filesystem_uuid": {"type": "string", "pattern": "^[a-fA-F0-9-]{8,64}$"}
      }
    }},
    "capacity": {"type": "object", "additionalProperties": false,
      "required": ["projected_bytes", "minimum_free_bytes", "reserve_fraction"],
      "properties": {"projected_bytes": {"type": "integer", "minimum": 1},
        "minimum_free_bytes": {"type": "integer", "minimum": 1},
        "reserve_fraction": {"type": "number", "minimum": 0.2, "maximum": 0.9}}},
    "host_capacity": {"type": "object", "additionalProperties": false,
      "required": ["observed_unix_seconds", "free_bytes", "projected_growth_bytes", "minimum_free_bytes"],
      "properties": {"observed_unix_seconds": {"type": "integer", "minimum": 0},
        "free_bytes": {"type": "integer", "minimum": 1}, "projected_growth_bytes": {"type": "integer", "minimum": 1},
        "minimum_free_bytes": {"type": "integer", "minimum": 1}}},
    "resources": {"type": "object", "additionalProperties": false, "required": ["controller", "helper"],
      "properties": {"controller": {"$ref": "#/$defs/resources"}, "helper": {"$ref": "#/$defs/resources"}}},
    "supplied_class": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "supplied_provisioner": {"type": "string", "minLength": 3, "maxLength": 128}
  },
  "allOf": [
    {"if": {"properties": {"profile": {"const": "node-local-lab"}}},
      "then": {"required": ["storage_root", "nodes", "capacity", "host_capacity"]}},
    {"if": {"properties": {"profile": {"const": "supplied-storage"}}},
      "then": {"required": ["supplied_class", "supplied_provisioner"]}}
  ],
  "$defs": {
    "resources": {"type": "object", "additionalProperties": false, "required": ["requests", "limits"],
      "properties": {"requests": {"$ref": "#/$defs/quantities"}, "limits": {"$ref": "#/$defs/quantities"}}},
    "quantities": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory"],
      "properties": {"cpu": {"type": "string", "pattern": "^[1-9][0-9]*(m)?$"},
        "memory": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"}}}
  }
}
