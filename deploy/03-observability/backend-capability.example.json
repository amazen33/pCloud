    "tempo": {
      "claim": "tempo-data",
      "size_gib": 4,
      "worker": "replace-worker-2"
    },
    "mimir": {
      "claim": "mimir-data",
      "size_gib": 8,
      "worker": "replace-worker-2"
    }
  },
  "components": {
    "loki": "3.7.8",
    "tempo": "2.10.8",
    "mimir": "2.17.11"
  },
  "fragments_sha256": "9d8851ffc32a1ba813363d4a842d08cd72dde28b97b489a5f94b2851e5e4b469",
  "deployment_mode": "one-monolithic-instance-per-component",
  "object_store_api": null,
