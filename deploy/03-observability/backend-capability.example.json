{
  "api": "pcloud.observability-backend/v1",
  "profile": "lab-filesystem",
  "namespace": "pcloud-observability",
  "mount_path": "/var/lib/pcloud/observability",
  "run_as_uid": 10001,
  "run_as_group": 10001,
